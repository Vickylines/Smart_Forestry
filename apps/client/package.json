{
  "name": "forest-observer-app",
  "version": "0.3.0-beta.4",
  "private": true,
  "description": "城市绿地植物调查跨平台 App",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app:resources": "uni build -p app-plus",
    "type-check": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs tests/taxonomy.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test:integration": "node tests/android-features.mjs",
    "test:regressions": "node tests/bug-regressions.mjs",
    "test:taxonomy": "node tests/taxonomy-browser.mjs",
    "test:taxonomy:live": "node --experimental-strip-types tests/taxonomy-live.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "playwright": "1.62.1",
    "typescript": "~4.9.5",
    "vite": "5.4.21",
    "vue-tsc": "~1.8.27",
    "adm-zip": "0.6.0"
  },
  "overrides": {
    "@dcloudio/vite-plugin-uni": {
      "vite": "$vite"
    },
    "@babel/core": "7.29.7",
    "@intlify/core-base": "9.14.5",
    "@intlify/message-resolver": "9.1.11",
    "adm-zip": "$adm-zip",
    "express": "4.22.2",
    "body-parser": "1.20.6",
    "jpeg-js": "0.4.4",
    "phin": "3.7.1",
    "postcss@^8.0.0": "8.5.28",
    "postcss-selector-parser@^6.0.0": "6.1.4",
    "qs": "6.16.0",
    "ws@^8.0.0": "8.21.0",
    "path-to-regexp@<0.2.0": "0.1.13",
    "esbuild": "0.25.12"
  }
}
